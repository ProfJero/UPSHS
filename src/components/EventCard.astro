---
import Icon from './Icon.astro';
import { dayNum, monthShort, eventWhen, plain, type SchoolEvent } from '../lib/content';
interface Props { event: SchoolEvent; i?: number; past?: boolean }
const { event, i = 0, past = false } = Astro.props;
---
<article class:list={['event-card', { 'is-past': past }]} data-reveal style={`--i:${i}`} data-filter-item data-category={event.category || 'Other'}>
  <div class="event-card__date" aria-hidden="true">
    <span class="event-card__month">{monthShort(event.startsAt)}</span>
    <span class="event-card__day">{dayNum(event.startsAt)}</span>
  </div>
  <div class="event-card__body">
    {event.category && <span class="chip chip--outline">{event.category}</span>}
    <h3><a href={`/events/${event.slug}/`} class="stretched">{event.title}</a></h3>
    <p class="event-card__when"><Icon name="clock" size={15} /> <time datetime={event.startsAt}>{eventWhen(event)}</time></p>
    {event.location && <p class="event-card__when"><Icon name="map-pin" size={15} /> {event.location}</p>}
    {event.summary && <p class="event-card__summary">{plain(event.summary, 140)}</p>}
  </div>
  <span class="event-card__go" aria-hidden="true"><Icon name="arrow-up-right" size={18} /></span>
</article>
<style>
  .event-card { position: relative; display: grid; grid-template-columns: auto 1fr auto; gap: 20px; align-items: start; padding: 20px; border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--line); transition: transform .5s var(--ease), box-shadow .5s var(--ease), border-color .3s; }
  .event-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--line-strong); }
  .event-card__date { width: 72px; height: 80px; border-radius: 18px; display: grid; place-items: center; align-content: center; background: var(--brand); color: #fff; box-shadow: 0 12px 22px -14px var(--brand); transition: transform .5s var(--ease); }
  .event-card:hover .event-card__date { transform: rotate(-4deg) scale(1.04); }
  .event-card__month { font-size: .72rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--gold-soft); }
  .event-card__day { font-family: var(--font-display); font-size: 2rem; font-weight: 600; line-height: 1; }
  .event-card__body { display: grid; gap: 7px; justify-items: start; }
  .event-card h3 { font-size: 1.12rem; font-weight: 700; line-height: 1.3; }
  .event-card h3 a { text-decoration: none; }
  .event-card__when { display: flex; gap: 7px; align-items: center; font-size: .86rem; color: var(--muted); }
  .event-card__summary { font-size: .9rem; color: var(--text-2); }
  .event-card__go { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--line); color: var(--muted); transition: background .3s, color .3s, transform .4s var(--ease); }
  .event-card:hover .event-card__go { background: var(--accent); color: var(--accent-ink); border-color: transparent; transform: rotate(45deg); }
  .event-card.is-past { opacity: .78; }
  .event-card.is-past .event-card__date { background: var(--surface-3); color: var(--text); box-shadow: none; }
  .event-card.is-past .event-card__month { color: var(--muted); }
  @media (max-width: 520px) { .event-card { grid-template-columns: auto 1fr; } .event-card__go { display: none; } .event-card__date { width: 60px; height: 68px; } .event-card__day { font-size: 1.6rem; } }
</style>
