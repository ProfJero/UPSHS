---
import { formatDate } from '../lib/format';
import type { NewsPost } from '../lib/types';
interface Props { post: NewsPost; }
const { post } = Astro.props;
const category = post.category?.name ?? 'School News';
---
<article class="news-card"><a class="news-card__image" href={`/news/${post.slug}/`} aria-label={`Read ${post.title}`}>{post.cover_image_url ? <img src={post.cover_image_url} alt="" loading="lazy" /> : <div class="image-placeholder image-placeholder--news"><span>UNIPRA</span><small>NEWS & STORIES</small></div>}<span class="news-card__category">{category}</span></a><div class="news-card__body"><div class="news-card__meta"><span>{formatDate(post.published_at || post.created_at)}</span><span>·</span><span>{'UNIPRA Editorial Team'}</span></div><h3><a href={`/news/${post.slug}/`}>{post.title}</a></h3><p>{post.excerpt || 'Read the latest story from University Practice Senior High School.'}</p><a class="text-link" href={`/news/${post.slug}/`}>Read story <span>↗</span></a></div></article>
