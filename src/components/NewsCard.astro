---
import Media from './Media.astro';
import Icon from './Icon.astro';
import { fmtDate, plain, readingTime, type NewsPost } from '../lib/content';
interface Props { post: NewsPost; size?: 'default' | 'feature' | 'compact'; i?: number }
const { post, size = 'default', i = 0 } = Astro.props;
---
<article class:list={['news-card card card--hover', `news-card--${size}`]} data-reveal style={`--i:${i}`} data-filter-item data-category={post.category || 'General'}>
  {size !== 'compact' && (
    <div class="card__media news-card__media">
      <Media media={post.coverImage} alt={post.title} w={size === 'feature' ? 1200 : 720} sizes={size === 'feature' ? '(max-width: 860px) 100vw, 60vw' : '(max-width: 640px) 100vw, 33vw'} />
      {post.category && <span class="chip news-card__cat">{post.category}</span>}
    </div>
  )}
  <div class="news-card__body">
    <p class="news-card__meta">
      <time datetime={post.publishedAt || undefined}>{fmtDate(post.publishedAt, { day: 'numeric', month: 'short', year: 'numeric' })}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)} min read</span>
    </p>
    <h3 class="news-card__title"><a href={`/news/${post.slug}/`} class="stretched">{post.title}</a></h3>
    {size !== 'compact' && <p class="news-card__excerpt">{post.excerpt || plain(post.body, size === 'feature' ? 220 : 130)}</p>}
    <span class="link-arrow news-card__more" aria-hidden="true">Read story <Icon name="arrow-up-right" size={16} /></span>
  </div>
</article>
<style>
  .news-card { display: flex; flex-direction: column; padding: 8px; height: 100%; }
  .news-card__media { flex: none; }
  .news-card__cat { position: absolute; left: 14px; top: 14px; background: var(--glass); backdrop-filter: blur(10px); color: var(--text); }
  .news-card__body { display: flex; flex-direction: column; gap: 10px; padding: 18px 16px 16px; flex: 1; }
  .news-card__meta { display: flex; gap: 8px; font-size: .8rem; color: var(--muted); font-weight: 600; }
  .news-card__title { font-family: var(--font-display); font-size: 1.32rem; line-height: 1.22; font-weight: 600; }
  .news-card__title a { text-decoration: none; background: linear-gradient(currentColor, currentColor) 0 100% / 0 1.5px no-repeat; transition: background-size .5s var(--ease); }
  .news-card:hover .news-card__title a { background-size: 100% 1.5px; }
  .news-card__excerpt { color: var(--muted); font-size: .95rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .news-card__more { margin-top: auto; padding-top: 6px; font-size: .9rem; }
  .news-card--feature .card__media { aspect-ratio: 16 / 9; }
  .news-card--feature .news-card__title { font-size: clamp(1.6rem, 2.6vw, 2.2rem); }
  .news-card--compact { padding: 4px; }
  .news-card--compact .news-card__body { padding: 16px; }
  .news-card--compact .news-card__title { font-size: 1.12rem; }
  .news-card--compact .news-card__more { display: none; }
</style>
