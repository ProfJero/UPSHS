---
import BrandMark from './BrandMark.astro';
import { safeHttpUrl } from '../lib/format';
interface Props { settings?: { school_name?: string; short_name?: string; motto?: string; location?: string; public_email?: string | null; public_phone?: string | null; postal_address?: string | null; social_links?: Record<string,string> } | null; }
const { settings } = Astro.props;
const year = new Date().getFullYear();
const socials = Object.entries(settings?.social_links || {}).map(([name,url]) => [name, safeHttpUrl(url)] as const).filter((item): item is readonly [string,string] => Boolean(item[1]));
---
<footer class="footer"><div class="container footer__main"><div class="footer__identity"><BrandMark light /><p>Learning with purpose. Growing in character. Serving the community.</p><span class="motto">“{settings?.motto || 'Service to the Community'}”</span>{socials.length > 0 && <div class="footer-socials">{socials.map(([name,url])=><a href={url} target="_blank" rel="noopener noreferrer">{name}</a>)}</div>}</div><div><h3>Explore</h3><a href="/about/">About the School</a><a href="/academics/">Academic Programmes</a><a href="/admissions/">Admissions</a><a href="/news/">News & Stories</a><a href="/announcements/">Announcements</a><a href="/events/">Events</a></div><div><h3>Connect</h3><a href="/gallery/">Photo Gallery</a><a href="/alumni/">Alumni</a><a href="/contact/">Contact Us</a><a href="/admin/">Staff Access</a><a href="/privacy/">Privacy Notice</a></div><div class="footer__contact"><h3>Find Us</h3><p>{settings?.postal_address || settings?.location || 'Cape Coast, Central Region, Ghana'}</p>{settings?.public_phone && <p><a href={`tel:${settings.public_phone}`}>{settings.public_phone}</a></p>}{settings?.public_email ? <p><a href={`mailto:${settings.public_email}`}>{settings.public_email}</a></p> : <p>Official contact details will be published after verification by the school.</p>}</div></div><div class="footer__bottom"><div class="container footer__bottom-inner"><span>© {year} {settings?.school_name || 'University Practice Senior High School'}. All rights reserved.</span><span>Built with care for the UNIPRA community.</span></div></div></footer>
<style>.footer-socials{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.footer-socials a{border:1px solid #ffffff25;border-radius:99px;padding:5px 9px;text-transform:capitalize}</style>
