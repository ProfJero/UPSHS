---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="Page not found | University Practice SHS" description="The page you requested could not be found." noIndex={true}>
  <section class="section"><div class="container empty-state"><span class="eyebrow"><span></span> Error 404</span><h1>We couldn't find that page.</h1><p>The address may have changed or the page may no longer be available.</p><a class="button button--primary" href="/">Return to the homepage <span>↗</span></a></div></section>
</SiteLayout>
<style>.empty-state h1{font:800 clamp(2rem,4vw,3.2rem) Manrope;color:var(--navy);letter-spacing:-.05em}</style>
