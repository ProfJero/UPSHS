---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import EmptyState from '../../components/EmptyState.astro';
import Media from '../../components/Media.astro';
import { getContent, school, markdown } from '../../lib/content';
const { leadership } = await getContent();
const s = await school();
const order = ['Administration', 'Board of Governors', 'Heads of Department', 'PTA Executive', 'Student Leadership'];
const groups = order.map((g) => ({ name: g, people: leadership.filter((p) => (p.group || 'Administration') === g) })).filter((g) => g.people.length);
const crumbs = [{ name: 'About', href: '/about/' }, { name: 'Leadership', href: '/about/leadership/' }];
const ld = leadership.length ? [{ '@context': 'https://schema.org', '@type': 'ItemList', name: 'UPSHS leadership', itemListElement: leadership.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Person', name: p.name, jobTitle: p.role, worksFor: { '@id': 'https://upshs.pages.dev/#school' } } })) }] : [];
---
<BaseLayout title="Leadership & Staff" description="Meet the headteacher, administration, heads of department, board and PTA executives of University Practice Senior High School, Cape Coast." breadcrumbs={crumbs} jsonLd={ld}>
  <PageHero eyebrow="Leadership" title="The people who lead UNIPRA." lead="Dedicated educators and partners who guide the school’s academic, pastoral and community life." crumbs={crumbs} />
  {s.headMessage && (
    <section class="section section--tight">
      <div class="container head-msg">
        <div class="head-msg__photo" data-reveal="left"><Media media={s.headPhoto} alt={s.headName || 'Headteacher'} w={600} ratio={4 / 5} /></div>
        <div data-reveal="right">
          <p class="eyebrow">From the Headteacher</p>
          <div class="prose" set:html={markdown(s.headMessage)} />
          {s.headName && <p class="head-msg__sign"><strong class="display">{s.headName}</strong><span>{s.headTitle || 'Headteacher'}</span></p>}
        </div>
      </div>
    </section>
  )}
  <section class="section">
    <div class="container">
      {groups.length ? groups.map((g) => (
        <div class="group">
          <h2 class="display h3 group__title" data-reveal>{g.name}</h2>
          <div class="people" data-stagger>
            {g.people.map((p) => (
              <article class="person" data-reveal>
                <div class="person__photo"><Media media={p.photo} alt={p.name} w={480} ratio={4 / 5} sizes="(max-width: 640px) 50vw, 25vw" /></div>
                <h3>{p.name}</h3>
                <p class="person__role">{p.role}</p>
                {p.bio && <p class="person__bio">{p.bio}</p>}
              </article>
            ))}
          </div>
        </div>
      )) : <EmptyState icon="users" title="Leadership profiles coming soon" text="Profiles of the headteacher, assistant heads, heads of department, board and PTA executives will be published here by the school." />}
    </div>
  </section>
</BaseLayout>
<style>
  .head-msg { display: grid; grid-template-columns: .7fr 1.3fr; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .head-msg__photo { aspect-ratio: 4 / 5; border-radius: var(--radius-xl); overflow: hidden; position: relative; }
  .head-msg__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .head-msg__sign { display: grid; margin-top: 24px; border-left: 3px solid var(--accent); padding-left: 14px; }
  .head-msg__sign strong { font-size: 1.4rem; }
  .head-msg__sign span { color: var(--muted); }
  @media (max-width: 760px) { .head-msg { grid-template-columns: 1fr; } .head-msg__photo { max-width: 320px; } }
  .group + .group { margin-top: 64px; }
  .group__title { margin-bottom: 24px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .people { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 24px; }
  .person { display: grid; gap: 4px; }
  .person__photo { position: relative; aspect-ratio: 4 / 5; border-radius: var(--radius-lg); overflow: hidden; margin-bottom: 12px; background: var(--surface-2); }
  .person__photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  .person:hover .person__photo :global(img) { transform: scale(1.05); }
  .person h3 { font-size: 1.1rem; font-weight: 700; }
  .person__role { color: var(--brand-ink); font-weight: 600; font-size: .92rem; }
  .person__bio { color: var(--muted); font-size: .9rem; margin-top: 6px; }
</style>
