---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { school } from '../lib/content';
const s = await school();
const crumbs = [{ name: 'Privacy', href: '/privacy/' }];
---
<BaseLayout title="Privacy Notice" description="How the University Practice SHS website handles information submitted through enquiry, alumni and newsletter forms." breadcrumbs={crumbs}>
  <PageHero eyebrow="Website information" title="Privacy notice." lead="What this website collects, why, and how it is protected." crumbs={crumbs} compact />
  <section class="section">
    <div class="container container--narrow prose">
      <h2>What we collect</h2>
      <p>This website only collects information you choose to send us:</p>
      <ul>
        <li><strong>Enquiry form</strong> — your name, email, optional phone number, subject and message.</li>
        <li><strong>Alumni register</strong> — your name, contact details, year group and the optional details you provide.</li>
        <li><strong>Newsletter</strong> — your email address.</li>
      </ul>
      <p>We do not sell your information or use it for advertising.</p>
      <h2>How it is used</h2>
      <p>Information is used only to respond to your enquiry, to keep the alumni register, or to send school updates you asked for. It is visible only to authorised school staff who sign in to the staff portal.</p>
      <h2>Where it is stored</h2>
      <p>Submissions are stored securely in Google Firebase (Cloud Firestore). The website is delivered by Cloudflare, and approved photos and documents are hosted by Cloudinary. Forms may use Cloudflare Turnstile to block automated spam.</p>
      <h2>How long we keep it</h2>
      <p>Enquiries are kept only as long as needed to deal with them. Alumni and newsletter records are kept until you ask us to remove them.</p>
      <h2>Your choices</h2>
      <p>You can ask to see, correct or delete the information you have given us, or unsubscribe from updates, by contacting the school{ s.email ? <> at <a href={`mailto:${s.email}`}>{s.email}</a></> : ' through the contact page' }.</p>
      <h2>Photographs of students</h2>
      <p>The school only publishes photographs approved for public display. If you would like an image removed, please contact the school.</p>
      <h2>Your browser</h2>
      <p>The site remembers your colour theme and mode on your device using local storage. It does not use advertising or tracking cookies.</p>
    </div>
  </section>
</BaseLayout>
