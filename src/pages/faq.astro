---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { FAQ } from '../data/school';
const crumbs = [{ name: 'FAQs', href: '/faq/' }];
const ld = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }];
---
<BaseLayout title="Frequently Asked Questions — Placement, Reporting & More" description="Answers for parents and students about University Practice SHS, Cape Coast: placement through the CSSPS, reporting, prospectus, Free SHS, WASSCE results and transcripts." breadcrumbs={crumbs} jsonLd={ld}>
  <PageHero eyebrow="Help centre" title="Questions, answered." lead="Quick answers for parents, students and old students. Can’t find what you need? Get in touch." crumbs={crumbs} compact />
  <section class="section">
    <div class="container faq-layout">
      <div class="faq-list">
        {FAQ.map((f, i) => (
          <details class="faq" id={f.id} data-reveal style={`--i:${i % 4}`} open={i === 0}>
            <summary><span>{f.q}</span><span class="faq__toggle" aria-hidden="true"><Icon name="plus" size={20} /></span></summary>
            <div class="faq__a">
              <p>{f.a}</p>
              {f.link && <a class="link-arrow" href={f.link.href} target="_blank" rel="noopener noreferrer">{f.link.label} <Icon name="arrow-up-right" size={16} /></a>}
            </div>
          </details>
        ))}
      </div>
      <aside class="faq-aside" data-reveal="right">
        <span class="faq-aside__icon"><Icon name="mail" size={24} /></span>
        <h2 class="display">Still have a question?</h2>
        <p>Our administration team is happy to help.</p>
        <a class="btn" href="/contact/">Contact the school <Icon name="arrow-right" size={18} /></a>
      </aside>
    </div>
  </section>
</BaseLayout>
<style>
  .faq-layout { display: grid; grid-template-columns: 1fr 320px; gap: clamp(24px, 4vw, 56px); align-items: start; }
  .faq-list { display: grid; gap: 12px; }
  .faq { border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--line); scroll-margin-top: calc(var(--header-h) + 20px); transition: border-color .3s, box-shadow .3s; }
  .faq[open] { border-color: var(--line-strong); box-shadow: var(--shadow); }
  .faq:target { box-shadow: 0 0 0 2px var(--accent); }
  .faq summary { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 22px 24px; cursor: pointer; list-style: none; font-weight: 700; font-size: 1.06rem; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq__toggle { flex: none; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--surface-2); transition: transform .4s var(--ease), background .3s, color .3s; }
  .faq[open] .faq__toggle { transform: rotate(45deg); background: var(--brand); color: #fff; }
  .faq__a { padding: 0 24px 24px; display: grid; gap: 12px; justify-items: start; color: var(--text-2); animation: rise .45s var(--ease); }
  .faq-aside { position: sticky; top: calc(var(--header-h) + 24px); display: grid; gap: 12px; justify-items: start; padding: 28px; border-radius: var(--radius-xl); background: var(--brand-tint); }
  .faq-aside__icon { width: 52px; height: 52px; border-radius: 16px; display: grid; place-items: center; background: var(--brand); color: #fff; }
  .faq-aside h2 { font-size: 1.6rem; }
  .faq-aside p { color: var(--muted); }
  @media (max-width: 900px) { .faq-layout { grid-template-columns: 1fr; } .faq-aside { position: static; } }
</style>
