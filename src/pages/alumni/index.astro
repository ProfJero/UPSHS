---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
---
<SiteLayout title="Alumni | University Practice SHS" description="Stay connected with the University Practice Senior High School alumni community.">
  <PageHero eyebrow="Old students & friends" title="Once a UNIPRAN, always a UNIPRAN." description="A lasting connection to the people, experiences and values that make our school community special."/>
  <section class="section"><div class="container split"><div><span class="eyebrow"><span></span> The alumni connection</span><h2 class="page-heading">The school story continues beyond graduation.</h2><p class="body-copy">Old students carry the school's memories, experiences and values into communities and professions across Ghana and around the world. This section will become a home for alumni stories, reunions, school legacy projects and approved opportunities to support the next generation.</p><p class="body-copy">The school and its recognised alumni association can use this platform to share verified updates and coordinate engagement.</p><a class="button button--primary" href="/contact/">Contact the school <span>↗</span></a></div><div class="alumni-art"><span>ONE SCHOOL</span><strong>Many journeys.</strong><small>ONE COMMUNITY</small></div></div></section>
  <section class="section section--wash"><div class="container"><div class="section-heading section-heading--center"><span class="eyebrow"><span></span> Future opportunities</span><h2>What this space can grow into.</h2></div><div class="identity-grid"><article><span>01</span><h3>Alumni stories</h3><p>Celebrating old students and their journeys, with consent and school approval.</p></article><article><span>02</span><h3>Reunions & events</h3><p>Sharing reunion notices and verified alumni community activities.</p></article><article><span>03</span><h3>Giving back</h3><p>Highlighting approved mentorship, partnership and school development initiatives.</p></article></div></div></section>
</SiteLayout>
<style>.page-heading{font:800 clamp(2rem,3.8vw,3.1rem)/1.1 Manrope;letter-spacing:-.06em;color:var(--navy);margin:15px 0 20px}.body-copy{font-size:.9rem;line-height:1.8;color:var(--muted)}.alumni-art{min-height:370px;border-radius:22px;background:linear-gradient(145deg,#082b46,#0e5943);color:white;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;overflow:hidden}.alumni-art:before,.alumni-art:after{content:'';position:absolute;border:1px solid #ffffff28;border-radius:50%;width:320px;height:320px;box-shadow:0 0 0 32px #ffffff08}.alumni-art:after{width:420px;height:420px}.alumni-art span,.alumni-art strong,.alumni-art small{z-index:1}.alumni-art span,.alumni-art small{font-size:.65rem;letter-spacing:.3em;color:#a3e2bc;font-weight:800}.alumni-art strong{font:800 2.3rem Manrope;letter-spacing:-.05em;margin:12px 0}</style>
