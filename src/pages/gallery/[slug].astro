---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getContent, cld, fmtDate, SITE_URL, type Album } from '../../lib/content';
export async function getStaticPaths() {
  const { albums } = await getContent();
  return albums.map((album) => ({ params: { slug: album.slug }, props: { album } }));
}
const { album } = Astro.props as { album: Album };
const images = album.images || [];
const crumbs = [{ name: 'Gallery', href: '/gallery/' }, { name: album.title, href: `/gallery/${album.slug}/` }];
const ld = [{ '@context': 'https://schema.org', '@type': 'ImageGallery', name: album.title, description: album.description, url: `${SITE_URL}/gallery/${album.slug}/`, image: images.slice(0, 30).map((img) => ({ '@type': 'ImageObject', contentUrl: cld(img.url, { w: 1600 }), caption: img.caption || img.alt })) }];
---
<BaseLayout title={`${album.title} — Gallery`} description={album.description || `Photos: ${album.title} at University Practice SHS, Cape Coast.`} image={(album.coverImage || images[0])?.url} breadcrumbs={crumbs} jsonLd={ld}>
  <PageHero eyebrow={album.date ? fmtDate(album.date, { month: 'long', year: 'numeric' }) : 'Album'} title={album.title} lead={album.description} crumbs={crumbs} compact />
  <section class="section section--tight">
    <div class="container">
      {images.length ? (
        <div class="masonry" data-lightbox>
          {images.map((img, i) => (
            <a href={cld(img.url, { w: 2000 })} data-lb-item data-caption={img.caption || ''} data-alt={img.alt || album.title} class="masonry__item" data-reveal="scale" style={`--i:${i % 4}`}>
              <img src={cld(img.url, { w: 640 })} alt={img.alt || `${album.title} — photo ${i + 1}`} loading="lazy" decoding="async" width={img.width || 640} height={img.height || 480} />
            </a>
          ))}
        </div>
      ) : <EmptyState icon="images" title="No photos yet" text="Photos for this album will appear soon." />}
    </div>
  </section>
</BaseLayout>
<style>
  .masonry { columns: 4 260px; column-gap: 14px; }
  .masonry__item { display: block; margin-bottom: 14px; border-radius: var(--radius); overflow: hidden; break-inside: avoid; position: relative; cursor: zoom-in; }
  .masonry__item img { width: 100%; height: auto; transition: transform .9s var(--ease), filter .4s; }
  .masonry__item:hover img { transform: scale(1.05); filter: brightness(1.05); }
</style>
