---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import EmptyState from '../../components/EmptyState.astro';
import Media from '../../components/Media.astro';
import { getContent, fmtDate } from '../../lib/content';
const { albums } = await getContent();
const crumbs = [{ name: 'Gallery', href: '/gallery/' }];
---
<BaseLayout title="Photo Gallery" description="Photos from school life at University Practice Senior High School, Cape Coast: events, sports, culture and celebrations." breadcrumbs={crumbs}>
  <PageHero eyebrow="Gallery" title="Moments that make UNIPRA." lead="Celebrations, competitions, culture and everyday school life — captured and shared with permission." crumbs={crumbs} compact />
  <section class="section">
    <div class="container">
      {albums.length ? (
        <div class="albums">
          {albums.map((a, i) => (
            <a href={`/gallery/${a.slug}/`} class="album" data-reveal style={`--i:${i % 3}`}>
              <div class="album__stack">
                <div class="album__img"><Media media={a.coverImage || a.images?.[0]} alt={a.title} w={720} ratio={4 / 3} /></div>
              </div>
              <div class="album__info">
                <h2>{a.title}</h2>
                <p>{a.date && <time datetime={a.date}>{fmtDate(a.date, { month: 'long', year: 'numeric' })}</time>} · {a.images?.length || 0} photos</p>
              </div>
            </a>
          ))}
        </div>
      ) : <EmptyState icon="images" title="Albums coming soon" text="Approved photos of school events and activities will be shared here." />}
    </div>
  </section>
</BaseLayout>
<style>
  .albums { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 28px 22px; }
  .album { text-decoration: none; display: grid; gap: 14px; }
  .album__stack { position: relative; }
  .album__stack::before, .album__stack::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius-lg); background: var(--surface-3); transition: transform .6s var(--ease); }
  .album__stack::before { transform: rotate(-3deg) translate(-4px, 4px); }
  .album__stack::after { transform: rotate(2deg) translate(4px, 2px); background: var(--surface-2); }
  .album:hover .album__stack::before { transform: rotate(-7deg) translate(-14px, 6px); }
  .album:hover .album__stack::after { transform: rotate(6deg) translate(14px, 4px); }
  .album__img { position: relative; z-index: 1; aspect-ratio: 4 / 3; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); }
  .album__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  .album:hover .album__img :global(img) { transform: scale(1.05); }
  .album h2 { font-size: 1.15rem; font-weight: 700; }
  .album p { color: var(--muted); font-size: .88rem; }
</style>
