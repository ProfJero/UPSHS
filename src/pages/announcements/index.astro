---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getServerSupabase } from '../../lib/server';
import { formatDate, safeHttpUrl } from '../../lib/format';
const supabase = getServerSupabase();
const { data } = supabase ? await supabase.from('announcements').select('id,title,body,link_url,priority,published_at,expires_at').eq('status','published').or('expires_at.is.null,expires_at.gt.' + new Date().toISOString()).order('published_at',{ascending:false}).limit(50) : { data: [] };
const announcements = data || [];
---
<SiteLayout title="Announcements | University Practice SHS" description="Official notices and important announcements from University Practice Senior High School, Cape Coast.">
  <PageHero eyebrow="Official notices" title="Information for our school community." description="Announcements published by the authorised University Practice Senior High School communications team."/>
  <section class="section"><div class="container">{announcements.length ? <div class="notice-list">{announcements.map((item) => <article class={`notice-card notice-card--${item.priority}`}><div class="notice-card__meta"><span class={`notice-priority notice-priority--${item.priority}`}>{item.priority}</span><time>{formatDate(item.published_at)}</time></div><h2>{item.title}</h2><p>{item.body}</p>{safeHttpUrl(item.link_url) && <a class="text-link" href={safeHttpUrl(item.link_url) || undefined} target="_blank" rel="noopener noreferrer">More information <span>↗</span></a>}</article>)}</div> : <div class="empty-state"><h3>No active announcements</h3><p>Official notices will appear here when the school publishes them.</p></div>}</div></section>
</SiteLayout>
<style>.notice-list{display:grid;gap:14px;max-width:930px;margin:0 auto}.notice-card{padding:24px 26px;border:1px solid var(--line);border-radius:15px;background:#fff}.notice-card--urgent{border-left:4px solid #c94e4e}.notice-card--important{border-left:4px solid var(--gold)}.notice-card__meta{display:flex;align-items:center;justify-content:space-between;gap:12px;color:var(--muted);font-size:.72rem}.notice-priority{text-transform:uppercase;letter-spacing:.12em;font-size:.62rem;font-weight:800;color:var(--green)}.notice-priority--urgent{color:#a43232}.notice-priority--important{color:#8c6825}.notice-card h2{font:800 1.15rem Manrope;color:var(--navy);margin:15px 0 8px}.notice-card p{font-size:.88rem;line-height:1.75;color:var(--muted);white-space:pre-line;margin:0 0 14px}</style>
