---
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import NewsCard from '../components/NewsCard.astro';
import { getServerSupabase } from '../lib/server';
import type { NewsPost, Announcement, SchoolEvent } from '../lib/types';
import { safeHttpUrl } from '../lib/format';

const supabase = getServerSupabase();
let posts: NewsPost[] = [];
let announcements: Announcement[] = [];
let events: SchoolEvent[] = [];
if (supabase) {
  const [newsResult, announcementResult, eventResult] = await Promise.all([
    supabase.from('news_posts').select('id,title,slug,excerpt,content,cover_image_url,published_at,created_at,category:news_categories(name,slug)').eq('status','published').order('published_at',{ascending:false}).limit(3),
    supabase.from('announcements').select('id,title,body,link_url,priority,published_at,expires_at').eq('status','published').or('expires_at.is.null,expires_at.gt.' + new Date().toISOString()).order('published_at',{ascending:false}).limit(3),
    supabase.from('events').select('id,title,slug,description,location,starts_at,ends_at,cover_image_url,status').eq('status','published').gte('starts_at',new Date().toISOString()).order('starts_at').limit(3),
  ]);
  posts = (newsResult.data || []) as unknown as NewsPost[];
  announcements = (announcementResult.data || []) as Announcement[];
  events = (eventResult.data || []) as SchoolEvent[];
}
const establishedYears = new Date().getFullYear() - 1976;
---
<SiteLayout title="University Practice Senior High School | Cape Coast" description="The official digital home of University Practice Senior High School, Cape Coast. Explore our story, academic life, news and community." >
  <section class="home-hero"><div class="home-hero__glow"></div><div class="container home-hero__grid"><div class="home-hero__copy"><span class="eyebrow eyebrow--light"><span></span> University Practice Senior High School · Cape Coast</span><h1>Learning with purpose.<br/><em>Growing to serve.</em></h1><p>A community shaped by learning, character and service. Discover the story, people and opportunities that make University Practice Senior High School part of Cape Coast’s educational story.</p><div class="home-hero__actions"><a class="button button--green" href="/about/">Discover our school <span>↗</span></a><a class="hero-text-link" href="/academics/">Explore academics <span>→</span></a></div><div class="hero-motto"><span class="hero-motto__line"></span><span>Service to the Community</span></div></div><div class="hero-art" aria-label="Illustration of a school campus"><div class="hero-art__sun"></div><div class="hero-art__cloud hero-art__cloud--one"></div><div class="hero-art__cloud hero-art__cloud--two"></div><div class="hero-art__hill"></div><div class="hero-building"><div class="hero-building__roof"></div><div class="hero-building__top"><span>UNIVERSITY PRACTICE</span><b>SENIOR HIGH SCHOOL</b></div><div class="hero-building__columns"><i></i><i></i><i></i><i></i><i></i></div><div class="hero-building__base"></div></div><div class="hero-tree hero-tree--left"></div><div class="hero-tree hero-tree--right"></div><div class="hero-art__label"><strong>UNIPRA</strong><span>CAPE COAST · GHANA</span></div><div class="hero-art__frame"></div></div></div><div class="container hero-bottom"><div class="hero-bottom__item"><strong>1976</strong><span>Established</span></div><div class="hero-bottom__divider"></div><div class="hero-bottom__item"><strong>{establishedYears}+</strong><span>Years of learning</span></div><div class="hero-bottom__divider"></div><div class="hero-bottom__item"><strong>One community</strong><span>United by service</span></div><div class="hero-bottom__note">A school story still being written.</div></div></section>

  <section class="section intro-section"><div class="container split"><div class="intro-visual"><div class="intro-visual__back"></div><div class="intro-visual__main"><div class="intro-visual__crest">UP<br/><small>SHS</small></div><div class="intro-visual__quote">“Service to the Community”</div><div class="intro-visual__caption"><span>OUR STORY</span><strong>Rooted in education.<br/>Growing through service.</strong></div></div><div class="intro-visual__stamp"><span>EST.</span><strong>1976</strong><small>CAPE COAST</small></div></div><div class="intro-copy"><span class="eyebrow"><span></span> Welcome to UNIPRA</span><h2>A tradition of learning, character and community.</h2><p>University Practice Senior High School began as an idea of the then Faculty of Education at the University of Cape Coast. The school was formally opened on 13 October 1976, with an initial cohort of 112 students across the sixth-form programmes.</p><p>Today, its story continues through the students, teachers, old students and partners who contribute to the life of the school. We invite you to learn more about our journey and our commitment to service.</p><a class="button button--outline" href="/about/">Our history & identity <span>↗</span></a><div class="intro-note"><span class="intro-note__icon">✳</span><span>School history and profile are presented from published school information and should be confirmed by school management before official launch.</span></div></div></div></section>

  <section class="section section--wash"><div class="container"><SectionHeading eyebrow="The UNIPRA experience" title="More than a place to study." description="A school community is shaped by the values it lives, the opportunities it creates and the service it gives." align="center"/><div class="feature-grid"><article class="feature-card"><span class="feature-card__icon">✦</span><h3>Academic growth</h3><p>Encouraging curiosity, discipline and the pursuit of knowledge.</p></article><article class="feature-card"><span class="feature-card__icon">◇</span><h3>Character & values</h3><p>Building responsibility, integrity and respect for others.</p></article><article class="feature-card"><span class="feature-card__icon">⌁</span><h3>Talent & development</h3><p>Making room for creativity, sport, leadership and student life.</p></article><article class="feature-card"><span class="feature-card__icon">✧</span><h3>Community service</h3><p>Learning to contribute meaningfully to the wider community.</p></article></div></div></section>

  <section class="section"><div class="container"><div class="section-row"><SectionHeading eyebrow="From the school community" title="News & announcements" description="Stories, notices and updates from University Practice Senior High School."/><div class="section-row__actions"><a class="text-link" href="/announcements/">All announcements ↗</a><a class="button button--outline section-row__link" href="/news/">View all news <span>↗</span></a></div></div>{announcements.length > 0 && <div class="announcement-list home-announcements">{announcements.map((item) => <article class="announcement"><div class="announcement__date">{item.priority === 'urgent' ? '!' : item.priority === 'important' ? '★' : 'i'}</div><div><h3>{item.title}</h3><p>{item.body}</p>{safeHttpUrl(item.link_url) && <a class="text-link" href={safeHttpUrl(item.link_url) || undefined} target="_blank" rel="noopener noreferrer">More information ↗</a>}</div></article>)}</div>}{posts.length > 0 ? <div class="news-grid home-news">{posts.map((post) => <NewsCard post={post}/>)}</div> : <div class="empty-state"><h3>School stories will appear here</h3><p>Updates and announcements will be published here by the authorised school communications team.</p></div>}</div></section>

  <section class="section section--wash"><div class="container"><div class="section-row"><SectionHeading eyebrow="Looking ahead" title="School life & upcoming events" description="Keep up with important dates and activities across the school community."/><a class="button button--outline section-row__link" href="/events/">Explore events <span>↗</span></a></div>{events.length ? <div class="event-grid">{events.map((event) => <article class="event-card"><div class="event-date"><strong>{new Date(event.starts_at).toLocaleDateString('en-GH',{day:'2-digit'})}</strong><span>{new Date(event.starts_at).toLocaleDateString('en-GH',{month:'short'})}</span></div><div><h3><a href={`/events/${event.slug}/`}>{event.title}</a></h3><p>{event.description || 'More information will be shared by the school.'}</p><small>{event.location || 'University Practice SHS'}</small></div></article>)}</div> : <div class="empty-state"><h3>Upcoming events</h3><p>School events and calendar information will be added by authorised administrators.</p></div>}</div></section>

  <section class="section"><div class="container"><div class="cta-band"><div class="cta-band__copy"><span class="eyebrow eyebrow--light"><span></span> Connected by our school</span><h2>Once a UNIPRAN, always a UNIPRAN.</h2><p>From current students to old students and friends of the school, every member of the UNIPRA community has a part in the story.</p></div><a class="button button--light" href="/alumni/">Explore alumni connections <span>↗</span></a></div></div></section>
</SiteLayout>
<style>
.home-hero{background:#082b46;position:relative;overflow:hidden;color:white;padding:67px 0 0}.home-hero:before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 73% 40%,#1c634f55,transparent 35%),linear-gradient(115deg,#082b46 0%,#0b3551 62%,#0b4939 100%)}.home-hero__glow{position:absolute;width:460px;height:460px;border:1px solid #ffffff11;border-radius:50%;right:-80px;top:-190px;box-shadow:0 0 0 50px #ffffff06,0 0 0 100px #ffffff04}.home-hero__grid{position:relative;z-index:1;display:grid;grid-template-columns:1fr 1.05fr;gap:45px;align-items:center}.eyebrow--light{color:#91e0b6}.eyebrow--light>span{background:#91e0b6}.home-hero h1{font:800 clamp(2.8rem,5.8vw,5.25rem)/1.02 Manrope;letter-spacing:-.075em;margin:23px 0 19px}.home-hero h1 em{font-style:normal;color:#7fd4a6}.home-hero__copy>p{max-width:525px;font-size:1.04rem;color:#ccdae3;line-height:1.85;margin:0}.home-hero__actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin-top:31px}.button--green{background:#16a36a;color:white}.button--green:hover{background:#087b4b}.hero-text-link{font-size:.86rem;color:white;text-decoration:none;font-weight:750}.hero-text-link span{margin-left:7px;color:#91e0b6}.hero-motto{display:flex;align-items:center;gap:13px;margin-top:48px;color:#b4c9d5;font:italic 600 .86rem Manrope}.hero-motto__line{height:1px;width:36px;background:#79d0a0}.hero-art{height:440px;position:relative;border:1px solid #ffffff25;border-radius:24px;overflow:hidden;background:linear-gradient(180deg,#a7c9d5 0%,#dce9df 61%,#82b28d 100%);box-shadow:0 24px 70px #0003}.hero-art__sun{position:absolute;top:50px;right:90px;width:100px;height:100px;border-radius:50%;background:#f2d7a2;opacity:.92}.hero-art__cloud{position:absolute;width:120px;height:23px;border-radius:40px;background:#ffffff83;filter:blur(1px)}.hero-art__cloud:before,.hero-art__cloud:after{content:'';position:absolute;border-radius:50%;background:inherit}.hero-art__cloud:before{width:50px;height:50px;left:19px;bottom:0}.hero-art__cloud:after{width:37px;height:37px;left:55px;bottom:0}.hero-art__cloud--one{top:105px;left:60px}.hero-art__cloud--two{top:158px;right:35px;transform:scale(.7)}.hero-art__hill{position:absolute;bottom:-35px;left:-20px;right:-20px;height:180px;background:#4d8d68;border-radius:50% 50% 0 0;transform:rotate(-4deg)}.hero-building{position:absolute;width:70%;height:225px;left:15%;bottom:65px;filter:drop-shadow(0 15px 13px #1c513a35)}.hero-building__roof{height:28px;background:#176649;clip-path:polygon(0 100%,7% 0,93% 0,100% 100%)}.hero-building__top{height:75px;background:#f2efe1;color:#15523c;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:5px;border-bottom:5px solid #b8a77a;letter-spacing:.08em;font-size:.7rem;font-weight:800}.hero-building__top b{font:800 .76rem Manrope}.hero-building__columns{height:98px;background:#e8e7d9;display:flex;align-items:stretch;justify-content:space-evenly;padding:0 14px}.hero-building__columns i{width:13px;background:linear-gradient(90deg,#c6c4b3,#fff,#c6c4b3);border-left:1px solid #c3c0ae;border-right:1px solid #c3c0ae}.hero-building__base{height:16px;background:#b4ac91}.hero-tree{position:absolute;bottom:62px;width:90px;height:175px}.hero-tree:before{content:'';position:absolute;left:40px;bottom:0;height:95px;width:10px;background:#79583b}.hero-tree:after{content:'';position:absolute;left:0;top:0;width:90px;height:110px;background:#397c57;border-radius:50% 50% 45% 45%;box-shadow:18px 10px 0 #4d9467,-12px 24px 0 #256d4b}.hero-tree--left{left:0;transform:scale(.9)}.hero-tree--right{right:0;transform:scale(.78)}.hero-art__label{position:absolute;left:20px;bottom:17px;display:flex;flex-direction:column;color:#174f3a}.hero-art__label strong{font:800 1.3rem Manrope;letter-spacing:.2em}.hero-art__label span{font-size:.52rem;letter-spacing:.19em;font-weight:800}.hero-art__frame{position:absolute;inset:12px;border:1px solid #ffffff7a;border-radius:17px;pointer-events:none}.hero-bottom{position:relative;z-index:2;display:flex;align-items:center;gap:28px;padding:26px 0 25px;margin-top:36px;border-top:1px solid #ffffff25}.hero-bottom__item{display:flex;align-items:center;gap:12px}.hero-bottom__item strong{font:800 1.12rem Manrope;color:white}.hero-bottom__item span{font-size:.72rem;color:#a9bfcc}.hero-bottom__divider{height:27px;width:1px;background:#ffffff2c}.hero-bottom__note{margin-left:auto;color:#91e0b6;font-size:.75rem;font-style:italic}.intro-section{overflow:hidden}.intro-visual{height:420px;position:relative}.intro-visual__back{position:absolute;left:18px;top:18px;right:30px;bottom:0;border-radius:22px;background:#d9e9df;transform:rotate(-4deg)}.intro-visual__main{position:absolute;inset:0 10px 10px 0;border-radius:22px;overflow:hidden;background:linear-gradient(145deg,#c7dfd1,#eaf2eb 50%,#a9cdb8);display:flex;align-items:center;justify-content:center}.intro-visual__main:before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,#ffffff30,transparent 45%,#082b4629)}.intro-visual__crest{width:128px;height:148px;border:3px solid #0b6c47;border-radius:48% 48% 42% 42%;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#0b6c47;font:800 2.2rem Manrope;box-shadow:0 0 0 8px #ffffff48;background:#ffffff68;transform:translateY(-28px)}.intro-visual__crest small{font-size:.8rem;letter-spacing:.2em}.intro-visual__quote{position:absolute;top:28px;left:30px;color:#0b6946;font:italic 700 .9rem Manrope}.intro-visual__caption{position:absolute;bottom:25px;left:30px;right:30px;display:flex;flex-direction:column;gap:8px;color:#082b46}.intro-visual__caption span{font-size:.65rem;font-weight:800;letter-spacing:.2em;color:#087b4b}.intro-visual__caption strong{font:800 1.3rem/1.25 Manrope}.intro-visual__stamp{position:absolute;right:-5px;top:44px;width:100px;height:100px;border-radius:50%;background:#082b46;color:white;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:0 12px 28px #082b4635;border:5px solid #d9e9df}.intro-visual__stamp span,.intro-visual__stamp small{font-size:.52rem;letter-spacing:.18em}.intro-visual__stamp strong{font:800 1.5rem Manrope;color:#9ce1ba}.intro-copy h2{font:800 clamp(2rem,3.6vw,3.2rem)/1.12 Manrope;letter-spacing:-.06em;color:var(--navy);margin:16px 0}.intro-copy>p{font-size:.95rem;color:#627687;line-height:1.85}.intro-note{display:flex;gap:11px;align-items:flex-start;margin-top:22px;padding:13px 14px;background:#f5f8f6;border-radius:10px;color:#708391;font-size:.72rem;line-height:1.55}.intro-note__icon{color:var(--green);font-size:1.1rem}.section-row{display:flex;align-items:flex-end;justify-content:space-between;gap:22px;margin-bottom:37px}.section-row .section-heading{margin:0}.section-row__link{flex:none;margin-bottom:5px}.section-row__actions{display:flex;align-items:center;gap:20px;flex-wrap:wrap}.home-news{margin-top:18px}.home-announcements{margin-bottom:18px}.event-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.event-card{display:flex;gap:15px;padding:20px;background:white;border:1px solid var(--line);border-radius:15px}.event-date{flex:none;width:57px;height:63px;border-radius:11px;background:var(--mint);color:var(--green);display:flex;flex-direction:column;align-items:center;justify-content:center}.event-date strong{font:800 1.45rem Manrope}.event-date span{font-size:.69rem;font-weight:800;text-transform:uppercase}.event-card h3 a{color:inherit;text-decoration:none}.event-card h3 a:hover{color:var(--green)}.event-card h3{font:750 1rem Manrope;color:var(--navy);margin:2px 0 6px}.event-card p{font-size:.78rem;line-height:1.6;color:var(--muted);margin:0 0 8px}.event-card small{font-size:.7rem;color:var(--green);font-weight:700}
@media(max-width:900px){.home-hero__grid{grid-template-columns:1fr;gap:32px}.home-hero__copy{max-width:700px}.hero-art{height:360px}.hero-bottom{flex-wrap:wrap}.hero-bottom__note{width:100%;margin-left:0}.event-grid{grid-template-columns:1fr 1fr}.intro-visual{height:350px}}
@media(max-width:620px){.home-hero{padding-top:54px}.home-hero h1{font-size:2.8rem}.home-hero__copy>p{font-size:.93rem}.home-hero__actions{gap:17px}.hero-art{height:280px}.hero-building{height:170px;bottom:50px}.hero-building__top{height:56px;font-size:.55rem}.hero-building__top b{font-size:.6rem}.hero-building__columns{height:75px}.hero-bottom{gap:13px;margin-top:22px}.hero-bottom__item{gap:7px}.hero-bottom__item strong{font-size:.85rem}.hero-bottom__item span{font-size:.63rem}.hero-bottom__divider{height:20px}.intro-visual{height:290px}.intro-visual__crest{width:95px;height:110px;font-size:1.8rem}.intro-visual__stamp{width:80px;height:80px;right:0}.intro-visual__stamp strong{font-size:1.2rem}.intro-visual__caption strong{font-size:1.05rem}.section-row{align-items:flex-start;flex-direction:column}.section-row__link{margin:0}.section-row__actions{align-items:flex-start;flex-direction:column;gap:12px}.event-grid{grid-template-columns:1fr}}
</style>
