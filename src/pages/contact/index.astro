---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ContactForm from '../../components/ContactForm';
---
<SiteLayout title="Contact | University Practice SHS" description="Contact University Practice Senior High School in Cape Coast. Use the enquiry form or consult verified school contact details.">
  <PageHero eyebrow="Contact the school" title="We welcome your enquiries." description="For school information, partnership enquiries and general communication, use the details confirmed by the school or send a message below."/>
  <section class="section"><div class="container form-grid"><div><span class="eyebrow"><span></span> Get in touch</span><h2 class="page-heading">A direct connection to UNIPRA.</h2><p class="contact-intro">We welcome enquiries from parents, prospective students, old students, partners and members of the wider community.</p><div class="contact-details"><div class="contact-detail"><span class="contact-detail__icon">⌖</span><div><strong>School location</strong><p>Cape Coast, Central Region, Ghana</p></div></div><div class="contact-detail"><span class="contact-detail__icon">✉</span><div><strong>Official email and telephone</strong><p>These details will be displayed once verified by school management.</p></div></div><div class="contact-detail"><span class="contact-detail__icon">◷</span><div><strong>Office hours</strong><p>Please contact the school through its verified channels for current office hours.</p></div></div></div><div class="map-placeholder"><span>⌖</span><strong>University Practice SHS</strong><small>Cape Coast · Central Region · Ghana</small></div></div><div><h2 class="form-heading">Send an enquiry</h2><p class="form-intro">Complete the form below. Your message will be available to authorised school administrators.</p><ContactForm client:load/></div></div></section>
</SiteLayout>
<style>.page-heading{font:800 clamp(2rem,3.8vw,3.1rem)/1.1 Manrope;letter-spacing:-.06em;color:var(--navy);margin:15px 0}.contact-intro,.form-intro{color:var(--muted);font-size:.87rem;line-height:1.75;margin:0 0 26px}.contact-details{margin:28px 0}.map-placeholder{min-height:160px;border-radius:15px;background:linear-gradient(135deg,#dcebe3,#eff5ef);display:flex;align-items:center;justify-content:center;flex-direction:column;color:var(--navy);gap:7px}.map-placeholder>span{font-size:1.8rem;color:var(--green)}.map-placeholder strong{font:800 1rem Manrope}.map-placeholder small{font-size:.7rem;color:var(--muted)}.form-heading{font:800 1.45rem Manrope;color:var(--navy);margin:0 0 8px}</style>
