---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import Media from '../../components/Media.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getContent, markdown, fmtDate, readingTime, plain, cld, SITE_URL, school, type NewsPost } from '../../lib/content';

export async function getStaticPaths() {
  const { news } = await getContent();
  return news.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: NewsPost };
const { news } = await getContent();
const s = await school();
const related = news.filter((n) => n.id !== post.id && (n.category === post.category || n.tags?.some((t) => post.tags?.includes(t)))).concat(news.filter((n) => n.id !== post.id)).filter((n, i, arr) => arr.findIndex((x) => x.id === n.id) === i).slice(0, 3);
const url = `${SITE_URL}/news/${post.slug}/`;
const description = post.excerpt || plain(post.body, 158);
const crumbs = [{ name: 'News', href: '/news/' }, { name: post.title, href: `/news/${post.slug}/` }];
const ld = [{
  '@context': 'https://schema.org', '@type': 'NewsArticle', headline: post.title.slice(0, 110), description, mainEntityOfPage: url, url,
  image: post.coverImage?.url ? [cld(post.coverImage.url, { w: 1200, h: 675, crop: 'fill' })] : [`${SITE_URL}/images/og-default.jpg`],
  datePublished: post.publishedAt || post.createdAt, dateModified: post.updatedAt || post.publishedAt,
  author: post.author ? { '@type': 'Person', name: post.author } : { '@type': 'Organization', name: s.name, url: SITE_URL },
  publisher: { '@id': `${SITE_URL}/#school` }, articleSection: post.category, keywords: post.tags?.join(', '),
}];
---
<BaseLayout title={post.title} description={description} image={post.coverImage?.url} type="article" breadcrumbs={crumbs} jsonLd={ld} publishedTime={post.publishedAt} modifiedTime={post.updatedAt}>
  <article class="article">
    <header class="article__head container container--narrow">
      <nav aria-label="Breadcrumb"><a href="/news/" class="link-arrow back"><Icon name="arrow-left" size={16} /> All news</a></nav>
      <div class="article__meta">
        {post.category && <span class="chip">{post.category}</span>}
        <time datetime={post.publishedAt || undefined}>{fmtDate(post.publishedAt)}</time>
        <span>·</span><span>{readingTime(post.body)} min read</span>
      </div>
      <h1 class="display article__title">{post.title}</h1>
      {post.excerpt && <p class="lead">{post.excerpt}</p>}
      <div class="article__by">
        <img src="/images/brand/icon-64.png" alt="" width="40" height="40" />
        <div><strong>{post.author || 'UPSHS Communications'}</strong><span>{s.name}</span></div>
        <button class="btn btn--ghost btn--sm" type="button" data-share><Icon name="share" size={16} /> <span>Share</span></button>
      </div>
    </header>
    {post.coverImage?.url && (
      <figure class="article__cover container">
        <div class="article__cover-img"><Media media={post.coverImage} alt={post.title} w={1600} ratio={16 / 9} sizes="(max-width: 1280px) 100vw, 1200px" eager /></div>
        {post.coverImage.caption && <figcaption>{post.coverImage.caption}</figcaption>}
      </figure>
    )}
    <div class="container container--narrow">
      <div class="prose article__body" set:html={markdown(post.body)} />
      {post.tags?.length ? <div class="article__tags">{post.tags.map((t) => <span class="chip chip--outline">#{t}</span>)}</div> : null}
    </div>
  </article>
  {related.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <h2 class="display h2" style="margin-bottom:32px">Keep reading</h2>
        <div class="grid grid-3">{related.map((p, i) => <NewsCard post={p} i={i} />)}</div>
      </div>
    </section>
  )}
</BaseLayout>
<style>
  .article { padding: clamp(40px, 6vw, 72px) 0 clamp(56px, 8vw, 96px); }
  .article__head { display: grid; gap: 20px; animation: rise .8s var(--ease) both; }
  .back { font-size: .9rem; }
  .back:hover :global(svg) { transform: translateX(-3px); }
  .article__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; color: var(--muted); font-size: .9rem; font-weight: 600; }
  .article__title { font-size: clamp(2.2rem, 5vw, 3.8rem); line-height: 1.06; }
  .article__by { display: flex; align-items: center; gap: 12px; padding-top: 20px; border-top: 1px solid var(--line); }
  .article__by img { border-radius: 50%; background: var(--surface-2); }
  .article__by div { display: grid; line-height: 1.3; }
  .article__by span { color: var(--muted); font-size: .85rem; }
  .article__by .btn { margin-left: auto; }
  .article__cover { margin: 40px auto; max-width: 1280px; animation: rise 1s .15s var(--ease) both; }
  .article__cover-img { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius-xl); overflow: hidden; }
  .article__cover-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .article__cover figcaption { text-align: center; color: var(--muted); font-size: .88rem; margin-top: 10px; }
  .article__body { margin-top: 40px; }
  .article__body > :global(p:first-child)::first-letter { font-family: var(--font-display); float: left; font-size: 4.2em; line-height: .85; padding: 6px 10px 0 0; color: var(--brand-ink); }
  .article__tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 40px; }
</style>
