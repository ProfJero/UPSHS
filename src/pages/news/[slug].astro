---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getServerSupabase } from '../../lib/server';
import { formatDate, readingTime } from '../../lib/format';
const supabase = getServerSupabase();
const slug = Astro.params.slug;
const { data: post } = supabase ? await supabase.from('news_posts').select('id,title,slug,excerpt,content,cover_image_url,published_at,created_at,category:news_categories(name)').eq('slug',slug).eq('status','published').maybeSingle() : {data:null};
if (!post) Astro.response.status = 404;
const paragraphs = String(post?.content || '').split(/\n\s*\n/).filter(Boolean);
---
<SiteLayout title={post ? `${post.title} | UNIPRA News` : 'Story not found | UNIPRA'} description={post?.excerpt || 'News and stories from University Practice Senior High School.'} noIndex={!post} image={post?.cover_image_url || undefined}>
  {post ? <><PageHero eyebrow={(post.category as any)?.name || 'School news' || 'School news'} title={post.title} description={post.excerpt || 'A story from the University Practice Senior High School community.'}/><article class="news-article"><div class="news-article__meta"><span>{formatDate(post.published_at || post.created_at)}</span><span>·</span><span>{'UNIPRA Editorial Team'}</span><span>·</span><span>{readingTime(post.content)} min read</span></div>{post.cover_image_url && <div class="news-article__cover"><img src={post.cover_image_url} alt={post.title}/></div>}<div class="news-article__body">{paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div><a class="button button--outline" href="/news/">← Back to news</a></article></> : <section class="section"><div class="container empty-state"><h3>This story is unavailable</h3><p>The story may have been unpublished or the address may be incorrect.</p><a class="button button--primary" href="/news/">Browse news <span>↗</span></a></div></section>}
</SiteLayout>
