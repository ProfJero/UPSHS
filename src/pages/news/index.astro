---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import NewsCard from '../../components/NewsCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getContent, SITE_URL } from '../../lib/content';
const { news } = await getContent();
const categories = [...new Set(news.map((n) => n.category || 'General'))];
const [first, ...rest] = news;
const crumbs = [{ name: 'News', href: '/news/' }];
const ld = news.length ? [{ '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'UPSHS News', url: `${SITE_URL}/news/`, mainEntity: { '@type': 'ItemList', itemListElement: news.slice(0, 30).map((n, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE_URL}/news/${n.slug}/` })) } }] : [];
---
<BaseLayout title="News & Stories" description="The latest news, stories and achievements from University Practice Senior High School, Cape Coast." breadcrumbs={crumbs} jsonLd={ld}>
  <PageHero eyebrow="Newsroom" title="News & stories." lead="What’s happening across the classrooms, fields, stages and community of UNIPRA." crumbs={crumbs} compact />
  <section class="section">
    <div class="container">
      {news.length ? (
        <>
          {categories.length > 1 && (
            <div class="filters" data-filter-group="#news-list" role="group" aria-label="Filter by category">
              <button type="button" data-filter="all" aria-pressed="true">All stories</button>
              {categories.map((c) => <button type="button" data-filter={c} aria-pressed="false">{c}</button>)}
            </div>
          )}
          <div id="news-list" class="news-list">
            {first && <div class="news-list__feature"><NewsCard post={first} size="feature" /></div>}
            {rest.map((p, i) => <NewsCard post={p} i={i % 3} />)}
          </div>
          <p class="filter-empty muted" data-filter-empty hidden>No stories in this category yet.</p>
        </>
      ) : <EmptyState icon="newspaper" title="Stories are on their way" text="News and stories will appear here as soon as the school publishes them. Subscribe at the bottom of the page to hear first." />}
    </div>
  </section>
</BaseLayout>
<style>
  .news-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .news-list__feature { grid-column: 1 / -1; }
  .news-list__feature :global(.news-card--feature) { display: grid; grid-template-columns: 1.3fr 1fr; align-items: center; }
  .news-list__feature :global(.news-card__body) { padding: 28px 32px; }
  .filter-empty { text-align: center; padding: 40px; }
  @media (max-width: 960px) { .news-list { grid-template-columns: 1fr 1fr; } .news-list__feature :global(.news-card--feature) { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .news-list { grid-template-columns: 1fr; } }
</style>
