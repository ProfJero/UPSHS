---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Media from '../../components/Media.astro';
import EventCard from '../../components/EventCard.astro';
import { getContent, markdown, eventWhen, isUpcoming, plain, cld, SITE_URL, type SchoolEvent } from '../../lib/content';
import { googleCalendarUrl } from '../../lib/ics';

export async function getStaticPaths() {
  const { events } = await getContent();
  return events.map((event) => ({ params: { slug: event.slug }, props: { event } }));
}
const { event } = Astro.props as { event: SchoolEvent };
const { events } = await getContent();
const more = events.filter((e) => e.id !== event.id && isUpcoming(e)).slice(0, 3);
const upcoming = isUpcoming(event);
const description = event.summary || plain(event.body, 158) || `${event.title} at University Practice SHS, Cape Coast.`;
const crumbs = [{ name: 'Events', href: '/events/' }, { name: event.title, href: `/events/${event.slug}/` }];
const ld = [{
  '@context': 'https://schema.org', '@type': 'Event', name: event.title, description, startDate: event.startsAt, endDate: event.endsAt || undefined,
  eventStatus: 'https://schema.org/EventScheduled', eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  image: event.coverImage?.url ? [cld(event.coverImage.url, { w: 1200, h: 675, crop: 'fill' })] : [`${SITE_URL}/images/og-default.jpg`],
  location: { '@type': 'Place', name: event.location || 'University Practice Senior High School', address: { '@type': 'PostalAddress', addressLocality: 'Cape Coast', addressRegion: 'Central Region', addressCountry: 'GH' } },
  organizer: { '@type': 'Organization', name: 'University Practice Senior High School', url: SITE_URL },
}];
---
<BaseLayout title={event.title} description={description} image={event.coverImage?.url} breadcrumbs={crumbs} jsonLd={ld}>
  <PageHero eyebrow={event.category || 'Event'} title={event.title} crumbs={crumbs} compact>
    <ul class="facts">
      <li><Icon name="calendar" size={18} /> <time datetime={event.startsAt}>{eventWhen(event)}</time></li>
      {event.location && <li><Icon name="map-pin" size={18} /> {event.location}</li>}
      {!upcoming && <li class="chip chip--flame">This event has ended</li>}
    </ul>
  </PageHero>
  <section class="section section--tight">
    <div class="container event-layout">
      <div>
        {event.coverImage?.url && <div class="event-cover"><Media media={event.coverImage} alt={event.title} w={1200} ratio={16 / 9} eager /></div>}
        {event.summary && <p class="lead">{event.summary}</p>}
        {event.body && <div class="prose" set:html={markdown(event.body)} />}
      </div>
      <aside class="event-side">
        <div class="event-box">
          <h2>Add to your calendar</h2>
          <a class="btn" href={googleCalendarUrl(event)} target="_blank" rel="noopener noreferrer"><Icon name="calendar-plus" size={18} /> Google Calendar</a>
          <a class="btn btn--ghost" href={`/events/${event.slug}.ics`} download><Icon name="download" size={18} /> Apple / Outlook (.ics)</a>
          <button class="btn btn--ghost" type="button" data-share><Icon name="share" size={18} /> <span>Share event</span></button>
        </div>
        <a class="link-arrow" href="/events/"><Icon name="arrow-left" size={16} /> Back to calendar</a>
      </aside>
    </div>
  </section>
  {more.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <h2 class="display h2" style="margin-bottom:28px">More coming up</h2>
        <div class="grid grid-3">{more.map((e, i) => <EventCard event={e} i={i} />)}</div>
      </div>
    </section>
  )}
</BaseLayout>
<style>
  .facts { list-style: none; padding: 0; margin: 6px 0 0; display: flex; flex-wrap: wrap; gap: 12px 24px; color: #dfe3f8; font-weight: 600; }
  .facts li { display: inline-flex; align-items: center; gap: 8px; }
  .facts :global(svg) { color: var(--gold); }
  .event-layout { display: grid; grid-template-columns: 1fr 340px; gap: clamp(28px, 5vw, 64px); align-items: start; }
  .event-layout > div { display: grid; gap: 24px; }
  .event-cover { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius-xl); overflow: hidden; }
  .event-cover :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .event-side { position: sticky; top: calc(var(--header-h) + 24px); display: grid; gap: 18px; }
  .event-box { display: grid; gap: 10px; padding: 24px; border-radius: var(--radius-lg); background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); }
  .event-box h2 { font-size: 1.05rem; font-weight: 700; margin-bottom: 4px; }
  @media (max-width: 900px) { .event-layout { grid-template-columns: 1fr; } .event-side { position: static; } }
</style>
