---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import EventCard from '../../components/EventCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import Icon from '../../components/Icon.astro';
import { getContent, isUpcoming, fmtDate, SITE_URL } from '../../lib/content';
const { events } = await getContent();
const upcoming = events.filter((e) => isUpcoming(e));
const past = events.filter((e) => !isUpcoming(e)).reverse().slice(0, 24);
// group upcoming by month
const months = new Map<string, typeof upcoming>();
for (const e of upcoming) {
  const key = fmtDate(e.startsAt, { month: 'long', year: 'numeric' });
  months.set(key, [...(months.get(key) || []), e]);
}
const categories = [...new Set(upcoming.map((e) => e.category || 'Other'))];
const crumbs = [{ name: 'Events', href: '/events/' }];
const ld = upcoming.slice(0, 20).map((e) => ({
  '@context': 'https://schema.org', '@type': 'Event', name: e.title, startDate: e.startsAt, endDate: e.endsAt || undefined,
  eventStatus: 'https://schema.org/EventScheduled', eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: { '@type': 'Place', name: e.location || 'University Practice Senior High School', address: { '@type': 'PostalAddress', addressLocality: 'Cape Coast', addressCountry: 'GH' } },
  organizer: { '@id': `${SITE_URL}/#school` }, url: `${SITE_URL}/events/${e.slug}/`, description: e.summary,
}));
---
<BaseLayout title="Events Calendar" description="Upcoming events at University Practice SHS, Cape Coast: term dates, PTA meetings, sports, speech day, cultural events and alumni reunions." breadcrumbs={crumbs} jsonLd={ld}>
  <PageHero eyebrow="School calendar" title="What’s on at UNIPRA." lead="Term dates, PTA meetings, sports, celebrations and reunions — add them straight to your phone’s calendar." crumbs={crumbs} compact>
    <div class="cal-actions">
      <a class="btn btn--accent btn--sm" href="/events/calendar.ics" download><Icon name="calendar-plus" size={17} /> Subscribe to calendar</a>
      <a class="btn btn--glass btn--sm" href="/announcements/"><Icon name="megaphone" size={17} /> Notice board</a>
    </div>
  </PageHero>
  <section class="section">
    <div class="container">
      {upcoming.length ? (
        <>
          {categories.length > 1 && (
            <div class="filters" data-filter-group="#event-months" role="group" aria-label="Filter by category">
              <button type="button" data-filter="all" aria-pressed="true">All events</button>
              {categories.map((c) => <button type="button" data-filter={c} aria-pressed="false">{c}</button>)}
            </div>
          )}
          <div id="event-months" class="months">
            {[...months].map(([month, list]) => (
              <div class="month">
                <h2 class="display month__title" data-reveal>{month}</h2>
                <div class="month__list">{list.map((e, i) => <EventCard event={e} i={i} />)}</div>
              </div>
            ))}
          </div>
          <p class="muted" data-filter-empty hidden>No upcoming events in this category.</p>
        </>
      ) : <EmptyState icon="calendar" title="No upcoming events yet" text="Term dates, PTA meetings and school events will appear here once they are published." />}

      {past.length > 0 && (
        <details class="past">
          <summary><span class="display">Past events</span> <span class="chip chip--outline">{past.length}</span> <Icon name="chevron-down" size={20} /></summary>
          <div class="past__list">{past.map((e) => <EventCard event={e} past />)}</div>
        </details>
      )}
    </div>
  </section>
</BaseLayout>
<style>
  .cal-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }
  .months { display: grid; gap: 48px; }
  .month { display: grid; grid-template-columns: 220px 1fr; gap: 24px; align-items: start; }
  .month__title { font-size: 1.6rem; position: sticky; top: calc(var(--header-h) + 24px); color: var(--brand-ink); }
  .month__list { display: grid; gap: 14px; }
  .month:has(.month__list > :not([hidden])) { display: grid; }
  .month:not(:has(.month__list > :not([hidden]))) { display: none; }
  @media (max-width: 860px) { .month { grid-template-columns: 1fr; } .month__title { position: static; } }
  .past { margin-top: 64px; border-top: 1px solid var(--line); padding-top: 24px; }
  .past summary { display: flex; align-items: center; gap: 12px; cursor: pointer; list-style: none; font-size: 1.5rem; }
  .past summary::-webkit-details-marker { display: none; }
  .past summary :global(svg) { margin-left: auto; transition: transform .3s var(--ease); }
  .past[open] summary :global(svg) { transform: rotate(180deg); }
  .past__list { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 24px; }
  @media (max-width: 860px) { .past__list { grid-template-columns: 1fr; } }
</style>
