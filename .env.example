# Copy to .env for local development. On Cloudflare Pages, set these under
# Settings → Variables and Secrets (they are public, build-time values).

# Where the site reads content from (the API Worker)
PUBLIC_API_URL=https://upshs.profjero947.workers.dev
# Canonical URL used for SEO, sitemap and social cards
PUBLIC_SITE_URL=https://upshs.pages.dev

# Google Search Console → Settings → Ownership verification → HTML tag (content value only)
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Optional: Bing Webmaster Tools verification
PUBLIC_BING_SITE_VERIFICATION=

# Optional: Cloudflare Turnstile site key for spam protection on forms
PUBLIC_TURNSTILE_SITE_KEY=

# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
