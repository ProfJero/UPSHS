# Browser-safe public configuration. Do not put service-role keys in this file.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
PUBLIC_SITE_URL=https://YOUR_APPROVED_DOMAIN
PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# Server-only secrets belong in Cloudflare Worker secrets or .dev.vars:
# SUPABASE_SERVICE_ROLE_KEY=
# TURNSTILE_SECRET_KEY=
